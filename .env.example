# Copy to .env.local for local development, and add the same keys in
# Vercel → Project → Settings → Environment Variables.
#
# The sender (From name and address) and the signature are edited in the app,
# not here.

# Resend API key (API Keys → Create). "Sending access" limited to your domain is enough.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Optional: where replies should go if not the From address.
REPLY_TO=

# Optional: where "Unsubscribe" requests are emailed (defaults to REPLY_TO, then the From address).
UNSUBSCRIBE_EMAIL=

# Login for the browser prompt. The password is required in production; the
# whole site is locked if it's missing. The username is optional: leave it
# empty and any username works.
APP_USERNAME=
APP_PASSWORD=change-me
